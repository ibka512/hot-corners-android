    <color name="md_tertiary_container">#FFDAD2</color>
    <color name="md_on_tertiary_container">#3B0904</color>
    <color name="md_background">#F8F7FC</color>
    <color name="md_on_surface">#1B1B22</color>
    <color name="md_surface">#FFFFFF</color>
    <color name="md_surface_container">#F0EFF6</color>
