    <string name="accessibility_service_label">Hot Corners for Android</string>
    <string name="accessibility_service_description">在已配置的屏幕角落创建透明鼠标悬停区域，并在鼠标停留后执行所选动作。</string>
    <string name="settings_title">Hot Corners</string>
    <string name="settings_summary">为屏幕四角分别选择动作。鼠标进入已启用的角落并停留约 300 毫秒后触发；离开后可以再次触发。</string>
